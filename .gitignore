# Build artifacts
/target
**/*.rs.bk

# cargo-fuzz build output and run artifacts. The fuzz targets and seed inputs are
# committed; the generated corpora, crash artifacts, and coverage are not.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Note: Cargo.lock is intentionally committed. This workspace builds a binary
# application, so a pinned lock file keeps builds reproducible (NFR-6, NFR-10).

# Editor and IDE files
.idea/
.vscode/
*.iml
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Local secrets and environment overrides. Never commit API keys.
.env
.env.*
*.pem

# Sextant on-disk model response cache
.sextant-cache/

# Internal audit working notes. Public security guidance lives in SECURITY.md.
/SECURITY_REVIEW.md
